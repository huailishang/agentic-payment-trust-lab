from __future__ import annotations

import dataclasses
import unittest

from src.agentic_payment_experiment.webshop_agent_behavior import (
    AgentPolicyInput,
    choose_webshop_action,
)


class WebShopAgentBehaviorTests(unittest.TestCase):
    def state(
        self,
        instruction: str,
        observation: str,
        clickables,
        *,
        has_search_bar: bool = False,
        previous=(),
        step_index: int = 0,
    ) -> AgentPolicyInput:
        return AgentPolicyInput(
            instruction_text=instruction,
            observation=observation,
            available_actions={
                "has_search_bar": has_search_bar,
                "clickables": list(clickables),
            },
            step_index=step_index,
            previous_actions=tuple(previous),
        )

    def test_policy_input_contract_is_exact(self) -> None:
        self.assertEqual(
            [field.name for field in dataclasses.fields(AgentPolicyInput)],
            [
                "instruction_text",
                "observation",
                "available_actions",
                "step_index",
                "previous_actions",
            ],
        )

    def test_search_query_is_derived_from_instruction(self) -> None:
        decision = choose_webshop_action(
            self.state(
                "find lightweight blue trail shoes for weekend hiking under 80 dollars",
                "WebShop [SEP] Instruction [SEP] Search",
                [],
                has_search_bar=True,
            )
        )
        self.assertFalse(decision.stop)
        self.assertTrue(decision.action.startswith("search["))
        self.assertIn("trail", decision.action)
        self.assertIn("shoes", decision.action)
        self.assertIn("blue", decision.action)
        self.assertNotIn("80", decision.action)

    def test_search_result_uses_instruction_overlap_and_budget(self) -> None:
        observation = (
            "Instruction [SEP] find orange cargo pants for hiking below 30 dollars "
            "[SEP] Back to Search [SEP] Page 1 "
            "[SEP] b000000001 [SEP] Decorative wooden table [SEP] $18.00 "
            "[SEP] b000000002 [SEP] Hiking cargo pants with utility pockets [SEP] $24.00"
        )
        decision = choose_webshop_action(
            self.state(
                "find orange cargo pants for hiking below 30 dollars",
                observation,
                ["back to search", "b000000001", "b000000002", "next >"],
                previous=("search[cargo pants hiking orange]",),
                step_index=1,
            )
        )
        self.assertEqual(decision.action, "click[b000000002]")

    def test_explicit_visible_option_is_selected_before_stop(self) -> None:
        decision = choose_webshop_action(
            self.state(
                "find orange cargo pants under 30 dollars",
                "Product detail [SEP] Color [SEP] orange [SEP] black [SEP] Buy Now",
                ["description", "orange", "black", "buy now"],
                previous=("search[cargo pants orange]", "click[b000000002]"),
                step_index=2,
            )
        )
        self.assertEqual(decision.action, "click[orange]")
        self.assertFalse(decision.stop)

    def test_encoded_visible_variant_is_selected_once_for_requested_root(self) -> None:
        clickables = [
            "description",
            "buy now",
            "green-alpha",
            "green1000",
            "green2000",
            "green1500",
        ]
        first = choose_webshop_action(
            self.state(
                "find green walking shoes under 50 dollars",
                "Product detail [SEP] color [SEP] green variants [SEP] Buy Now",
                clickables,
                previous=("search[green walking shoes]", "click[b000000002]"),
                step_index=2,
            )
        )
        self.assertEqual(first.action, "click[green1500]")

        second = choose_webshop_action(
            self.state(
                "find green walking shoes under 50 dollars",
                "Product detail [SEP] color [SEP] green variants [SEP] Buy Now",
                clickables,
                previous=(
                    "search[green walking shoes]",
                    "click[b000000002]",
                    "click[green1500]",
                ),
                step_index=3,
            )
        )
        self.assertTrue(second.stop)
        self.assertIsNone(second.action)

    def test_numeric_option_requires_exact_requested_value_and_is_not_reselected(self) -> None:
        clickables = ["buy now", "10", "10.5", "11"]
        first = choose_webshop_action(
            self.state(
                "find men's size 10.5 loafers under 60 dollars",
                "Product detail [SEP] size [SEP] 10 [SEP] 10.5 [SEP] 11 [SEP] Buy Now",
                clickables,
                previous=("search[men loafers 10.5]", "click[b000000002]"),
                step_index=2,
            )
        )
        self.assertEqual(first.action, "click[10.5]")

        second = choose_webshop_action(
            self.state(
                "find men's size 10.5 loafers under 60 dollars",
                "Product detail [SEP] size [SEP] 10 [SEP] 10.5 [SEP] 11 [SEP] Buy Now",
                clickables,
                previous=(
                    "search[men loafers 10.5]",
                    "click[b000000002]",
                    "click[10.5]",
                ),
                step_index=3,
            )
        )
        self.assertTrue(second.stop)
        self.assertIsNone(second.action)

    def test_multiword_visible_option_can_match_requested_root(self) -> None:
        decision = choose_webshop_action(
            self.state(
                "find small charcoal university shorts",
                "Product detail [SEP] color [SEP] heather charcoal [SEP] size [SEP] small [SEP] Buy Now",
                ["buy now", "heather charcoal", "heather grey", "small", "medium"],
                previous=("search[charcoal university shorts]", "click[b000000002]", "click[small]"),
                step_index=3,
            )
        )
        self.assertEqual(decision.action, "click[heather charcoal]")

    def test_buy_now_is_never_executed(self) -> None:
        decision = choose_webshop_action(
            self.state(
                "find orange cargo pants under 30 dollars",
                "Product detail [SEP] orange [SEP] Buy Now",
                ["orange", "buy now"],
                previous=(
                    "search[cargo pants orange]",
                    "click[b000000002]",
                    "click[orange]",
                ),
                step_index=3,
            )
        )
        self.assertTrue(decision.stop)
        self.assertIsNone(decision.action)

    def test_numeric_option_requires_exact_value(self) -> None:
        decision = choose_webshop_action(
            self.state(
                "find walking shoes in size 10.5",
                "Product detail [SEP] size [SEP] 10 [SEP] 10.5 [SEP] Buy Now",
                ["10", "10.5", "buy now"],
                previous=("search[walking shoes]", "click[b000000003]"),
                step_index=2,
            )
        )
        self.assertEqual(decision.action, "click[10.5]")

    def test_selected_option_dimension_is_not_overwritten(self) -> None:
        decision = choose_webshop_action(
            self.state(
                "find a red shirt in x-large",
                "Product detail [SEP] size [SEP] large [SEP] x-large [SEP] xx-large "
                "[SEP] color [SEP] red [SEP] Buy Now",
                ["large", "x-large", "xx-large", "red", "buy now"],
                previous=(
                    "search[red shirt]",
                    "click[b000000004]",
                    "click[x-large]",
                ),
                step_index=3,
            )
        )
        self.assertEqual(decision.action, "click[red]")

    def test_explicit_budget_dominates_overbudget_lexical_overlap(self) -> None:
        observation = (
            "Instruction [SEP] find black rubber sole loafers below 60 dollars "
            "[SEP] Back to Search [SEP] Page 1 "
            "[SEP] b000000005 [SEP] Black rubber sole loafers [SEP] $100.00 "
            "[SEP] b000000006 [SEP] Mens casual loafers [SEP] $35.00"
        )
        decision = choose_webshop_action(
            self.state(
                "find black rubber sole loafers below 60 dollars",
                observation,
                ["back to search", "b000000005", "b000000006", "next >"],
                previous=("search[black rubber sole loafers]",),
                step_index=1,
            )
        )
        self.assertEqual(decision.action, "click[b000000006]")


if __name__ == "__main__":
    unittest.main()
