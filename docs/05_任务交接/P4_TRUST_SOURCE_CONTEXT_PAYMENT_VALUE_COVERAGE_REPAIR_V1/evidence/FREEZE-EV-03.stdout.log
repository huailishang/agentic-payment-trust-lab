+def _path_exists(state: Mapping[str, Any], path: str) -> bool:
+    cursor: Any = state
+    for part in path.split("."):
+        if not isinstance(cursor, Mapping) or part not in cursor:
+            return False
+        cursor = cursor[part]
+    return True
+
+
+def _get_path(state: Mapping[str, Any], path: str) -> Any:
+    cursor: Any = state
+    for part in path.split("."):
+        cursor = cursor[part]
+    return cursor
